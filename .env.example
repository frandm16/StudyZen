# Compose ports
BACKEND_PUBLIC_PORT=8082
BACKEND_PRIVATE_PORT=8080
FRONTEND_PORT=7777

# Database
DB_NAME=studytracker
DB_USER=studyzen
DB_PASSWORD=

JWT_SECRET=random-secret-at-least-32-characters

# Frontend origin and cookie security
FRONTEND_URL=http://localhost:7777
CORS_ALLOWED_ORIGIN=http://localhost:7777
COOKIE_SECURE=false

# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP settings for account verification and recovery email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=noreply@studyzen.local

# Optional token lifetimes in milliseconds
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# Frontend image build settings
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=
